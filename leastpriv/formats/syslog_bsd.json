{
  "name": "syslog_bsd",
  "description": "BSD syslog header: 'Mon DD HH:MM:SS host process[pid]: message' (shape of the Loghub Linux and OpenSSH samples; the process tag may contain spaces, e.g. 'syslogd 1.4.1')",
  "order": 50,
  "type": "regex",
  "pattern": "^(?P<month>[A-Z][a-z]{2})\\s+(?P<day>\\d{1,2})\\s+(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+(?P<host>\\S+)\\s+(?P<process>[^\\[:]+?)(?:\\[(?P<pid>\\d+)\\])?:\\s?(?P<message>.*)$",
  "mapping": {
    "metadata.original_time": "{month} {day} {time}",
    "device.hostname": "{host}",
    "actor.process.name": "{process}",
    "actor.process.pid": {"value": "{pid}", "type": "int"},
    "message": "{message}"
  }
}
